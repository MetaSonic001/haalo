# =====================================================================================
# Sneha: copy this file to `.env` (repo root) and fill in what you have. NEVER commit .env.
# One file drives the voice service, the web app and the mobile app.
# Every provider/language/voice/model is chosen here. Swap by editing values, no code changes.
# =====================================================================================

# ---------- Runtime ----------
APP_ENV=development            # development | production
DEV_ONLY=true                  # allows DEV_ONLY providers (Edge TTS). Service REFUSES to start if true in production.
LOG_LEVEL=INFO
PORT=7860
PUBLIC_VOICE_BASE_URL=         # https URL of the voice service. Dev: a tunnel URL (needed only for Twilio, not for browser demo)
INTERNAL_SERVICE_KEY=          # any long random string; web server routes use it to call POST /calls/dial

# ---------- Supabase (hosted project; no Docker) ----------
# Dashboard > Project Settings > API
SUPABASE_URL=
SUPABASE_ANON_KEY=               # publishable (sb_publishable_...) or legacy anon key
SUPABASE_SERVICE_ROLE_KEY=     # the sb_secret_... key. Voice service + Next.js server routes ONLY. Never expose to a client.
DIRECT_URL=                    # Postgres session-pooler URL, used only by supabase/apply.py to apply migrations

# ---------- Auth: Clerk ----------
# Clerk dashboard > API keys. Also: Clerk "Connect with Supabase" (adds role=authenticated to session tokens) and
# Supabase > Authentication > Third-Party Auth > add Clerk (your Clerk domain). See context/progress-tracker.md.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/login
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app

# ---------- LLM: Groq ----------
# Get a key at console.groq.com. Then run `uv run haalo-models` (in services/voice) to list VALID model ids for your key.
# The service validates these against GET /openai/v1/models at startup and refuses to boot if one is unknown.
GROQ_API_KEY=
GROQ_MODEL_CONVERSATION=       # best multilingual quality at acceptable latency
GROQ_MODEL_FAST=               # small/fast: safety classification
GROQ_MODEL_SUMMARY=            # reliable JSON output: post-call summary
GROQ_MODEL_FALLBACK=           # optional: used automatically if the conversation model errors / rate-limits

# ---------- Speech-to-text ----------
# Providers: groq_whisper (free tier) | sarvam | bhashini | indic_local
DEFAULT_STT_PROVIDER=groq_whisper
STT_FALLBACK_PROVIDER=         # e.g. bhashini. Used automatically if the primary fails mid-call.
GROQ_STT_MODEL=whisper-large-v3-turbo
# Per-language override (any language code from packages/shared/languages.json), e.g.:
# STT_PROVIDER_MR=sarvam
# STT_PROVIDER_HI=groq_whisper

# ---------- Text-to-speech ----------
# Providers: edge (DEV_ONLY) | sarvam | bhashini | indic_local | groq_orpheus (English only)
DEFAULT_TTS_PROVIDER=edge
TTS_FALLBACK_PROVIDER=
# Per-language override, e.g. use Sarvam only for Marathi while everything else stays on Edge:
# TTS_PROVIDER_MR=sarvam
# TTS_FALLBACK_MR=edge
SARVAM_API_KEY=                # only if you use sarvam for STT or TTS
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
BHASHINI_USER_ID=              # only for bhashini (free; best effort, no SLA)
BHASHINI_API_KEY=
BHASHINI_PIPELINE_ID=
INDIC_LOCAL_URL=               # optional self-hosted GPU/CPU box running AI4Bharat models (see services/voice/README.md)

# ---------- Turn-taking (elderly friendly; per-parent values in the DB override these) ----------
DEFAULT_SILENCE_MS=1000
DEFAULT_TTS_PACE=0.9
NO_RESPONSE_SECONDS=8
NO_RESPONSE_MAX_TRIES=2
MAX_CALL_MINUTES=10

# ---------- Interruptions / noise (tune if the agent still cuts off too easily or is slow to yield) ----------
BARGE_IN_MIN_WORDS=3           # words the parent must say to interrupt the agent (noise, coughs, 1-2 stray words don't)
VAD_CONFIDENCE=0.8             # higher = ignores more background noise
VAD_MIN_VOLUME=0.55
VAD_START_SECS=0.3
MUTE_UNTIL_FIRST_BOT_COMPLETE=true   # noise can't cut off the opening/consent line

# ---------- Optional self-hosted Indic STT (services/indic-local, free, no Docker) ----------
HF_TOKEN=                      # Hugging Face read token (IndicConformer is gated: accept its terms first)
INDIC_STT_DECODER=ctc          # ctc (faster) | rnnt (more accurate)

# ---------- Telephony ----------
# Providers: twilio (now) | exotel | plivo (adapters land before paying customers; switching = change this one value)
TELEPHONY_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=           # your Twilio number in E.164, e.g. +1415...
TWILIO_TRIAL=true              # trial: verified numbers only, trial message, 10 min cap. Set false after upgrading.
# Exotel / Plivo (later)
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=
EXOTEL_CALLER_ID=
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_NUMBER=

# ---------- Scheduler ----------
SCHEDULER_ENABLED=true
SCHEDULER_POLL_SECONDS=30
CALL_RETRY_MINUTES=15
CALL_MAX_RETRIES=2

# ---------- Public demo protection (Cloudflare Turnstile, free) ----------
TURNSTILE_SECRET=              # server secret. Mandatory when APP_ENV=production
DEMO_MAX_SECONDS=180

# ---------- Cost rates (so cost_breakdown is real; leave 0 while on free tiers) ----------
RATE_TELEPHONY_PER_MIN=0
RATE_STT_PER_SECOND=0
RATE_LLM_PER_1K_TOKENS=0
RATE_TTS_PER_1K_CHARS=0

# ---------- Web (Next.js) ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=   # same public key as above (legacy name NEXT_PUBLIC_SUPABASE_ANON_KEY also accepted)
NEXT_PUBLIC_VOICE_DEMO_URL=http://localhost:7860
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
VOICE_SERVICE_URL=              # server-side URL of the voice service (defaults to PUBLIC_VOICE_BASE_URL / demo URL)

# ---------- Mobile (Expo) ----------
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=   # same public key (legacy EXPO_PUBLIC_SUPABASE_ANON_KEY also accepted)
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_WEB_URL=http://localhost:3000   # the web app: the mobile app calls its /api/calls/now for Call now
EXPO_PUBLIC_VOICE_URL=http://localhost:7860  # for voice previews
EXPO_PUBLIC_EAS_PROJECT_ID=      # needed for Expo push tokens (create a free EAS project)

# ---------- Errors ----------
SENTRY_DSN=

# Care features
DOSE_REMIND_RETRY_MINUTES=20
DOSE_MAX_REMINDERS=2
DOSE_MISSED_AFTER_MINUTES=90
ESCALATION_STEP_SECONDS=300
ESCALATION_MISSED_DAYS=2
# Photo proofs read by a vision model (defaults to GROQ_MODEL_CONVERSATION when it accepts images)
GROQ_MODEL_VISION=

# Demo workspace: a sandbox family with made-up data at /demo (run `uv run python -m haalo_voice.demo_seed` to create or reset it)
DEMO_WORKSPACE=false
DEMO_FAMILY_ID=
